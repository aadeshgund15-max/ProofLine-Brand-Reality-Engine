# Template only. Populate in the hosting secret manager; do not commit actual values.
AUTH_MODE=supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=submissions
STORAGE_DIR=
CORS_ORIGINS=https://app.example.com

# Provider secrets belong only in the backend secret store.
SEARCH_PROVIDER=
