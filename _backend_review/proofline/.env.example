# ---- Database (required). Supabase: Project Settings > Database > connection string (use the pooler URI).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ---- Auth: "supabase" (default when SUPABASE_URL is set) or "local" (dev without Supabase)
AUTH_MODE=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# JWT secret (legacy HS256 projects). Projects using asymmetric signing keys need no secret: JWKS is used.
SUPABASE_JWT_SECRET=
# Server-side only. Used for private Storage. NEVER expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=submissions

# ---- Local mode only (AUTH_MODE=local): at least 32 random characters
LOCAL_JWT_SECRET=
STORAGE_DIR=./.storage

# ---- Optional providers. Leave blank and the related stages report "unavailable".
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
SEARCH_PROVIDER=            # tavily | brave
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---- Limits
MAX_UPLOAD_MB=15
MAX_URL_FETCH_MB=2
URL_FETCH_TIMEOUT_S=10
REVIEW_RATE_PER_MIN=20
CORS_ORIGINS=http://localhost:5173
