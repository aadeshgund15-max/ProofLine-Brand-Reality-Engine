# ── Frontend (browser-safe; these VITE_ values are bundled into the app) ──────
VITE_API_BASE=
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-PUBLISHABLE-OR-ANON-KEY

# ── Backend (server only; never expose these values to the browser) ──────────
# Supabase: use the Session pooler URL from Dashboard → Connect for IPv4-only networks; the direct db.<project-ref>.supabase.co host is IPv6-only by default.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
AUTH_MODE=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Optional local-only auth mode (does not provide email verification or Google OAuth)
LOCAL_JWT_SECRET=
STORAGE_DIR=./.storage
STORAGE_BUCKET=submissions

# Optional review providers; empty values make their stages report unavailable
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_API_KEY=

MAX_UPLOAD_MB=15
MAX_URL_FETCH_MB=2
URL_FETCH_TIMEOUT_S=10
REVIEW_RATE_PER_MIN=20
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173