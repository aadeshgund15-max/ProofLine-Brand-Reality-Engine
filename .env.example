# ── Frontend (browser-safe; these VITE_ values are bundled into the app) ──────
VITE_API_BASE=
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-PUBLISHABLE-OR-ANON-KEY
# Optional public hackathon demo credentials. These are bundled into the login page.
# Create this user as confirmed in Supabase Auth before using the demo button.
VITE_DEMO_EMAIL=demo@example.com
VITE_DEMO_PASSWORD=replace-with-demo-password

# ── Backend (server only; never expose these values to the browser) ──────────
# Supabase: use the Session pooler URL from Dashboard → Connect for IPv4-only networks; the direct db.<project-ref>.supabase.co host is IPv6-only by default.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
AUTH_MODE=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Optional local-only auth mode (does not provide email verification or Google OAuth)
LOCAL_JWT_SECRET=
STORAGE_DIR=./.storage
STORAGE_BUCKET=submissions

# Optional review providers; empty values make their stages report unavailable
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_API_KEY=

# Visual palette screening (server-side; Delta E threshold and minimum page/image coverage)
PROOFLINE_VISUAL_DELTA_E_THRESHOLD=18
PROOFLINE_VISUAL_COVERAGE_THRESHOLD=0.12
PROOFLINE_LOGO_MAX_HASH_DISTANCE=7
PROOFLINE_APPROVED_FONT_FAMILIES=
PROOFLINE_FONT_MIN_SIZE_PT=
PROOFLINE_FONT_MAX_SIZE_PT=
PROOFLINE_LAYOUT_MIN_MARGIN_INCHES=

# Source-age triage thresholds (days); signals are indicative, not verification.
PROOFLINE_SOURCE_FRESH_DAYS=365
PROOFLINE_SOURCE_OUTDATED_DAYS=1095

# Optional validated governance policy; JSON may override version and named risk weights.
# See BACKEND_README.md. Outcome safety rules remain fail-closed.
PROOFLINE_GOVERNANCE_POLICY_VERSION=baseline-1
PROOFLINE_GOVERNANCE_POLICY_JSON=

MAX_UPLOAD_MB=15
MAX_URL_FETCH_MB=2
URL_FETCH_TIMEOUT_S=10
REVIEW_RATE_PER_MIN=20
MAX_CLAIMS_PER_REVIEW=50
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
